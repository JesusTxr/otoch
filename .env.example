# Otoch v1.0.0 · Variables de entorno (copiar como apps/web/.env.local y completar)
# Las variables NEXT_PUBLIC_ se exponen al navegador: solo valores públicos.
# Los secretos se guardan cifrados en Vercel y en los secretos de GitHub Actions. Nunca se versionan.

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=https://otoch.mx

# --- Supabase (llaves nuevas: publicable y secreta) ---
NEXT_PUBLIC_SUPABASE_URL=https://[COMPLETAR-ref].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_[COMPLETAR]
SUPABASE_SECRET_KEY=sb_secret_[COMPLETAR]
# Solo en GitHub Actions (migraciones y respaldos), conexión por pool:
SUPABASE_DB_URL=postgresql://[COMPLETAR]

# --- Correo transaccional ---
RESEND_API_KEY=re_[COMPLETAR]

# --- Mapas (token restringido por dominio) ---
NEXT_PUBLIC_MAPBOX_TOKEN=pk.[COMPLETAR]

# --- Anti-bots ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=[COMPLETAR]
TURNSTILE_SECRET_KEY=[COMPLETAR]

# --- Observabilidad ---
NEXT_PUBLIC_SENTRY_DSN=https://[COMPLETAR]
SENTRY_AUTH_TOKEN=[COMPLETAR]

# --- Notificaciones Web Push ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=[COMPLETAR]
VAPID_PRIVATE_KEY=[COMPLETAR]

# --- Banderas de funcionalidad (Vercel Edge Config) ---
EDGE_CONFIG=https://edge-config.vercel.com/[COMPLETAR]

# --- Respaldos (solo GitHub Actions) ---
R2_ACCESS_KEY_ID=[COMPLETAR]
R2_SECRET_ACCESS_KEY=[COMPLETAR]
R2_ENDPOINT=https://[COMPLETAR-cuenta].r2.cloudflarestorage.com
R2_BUCKET=otoch-respaldos
BACKUP_AGE_RECIPIENT=age1[COMPLETAR]

# --- Despliegue desde CI (solo GitHub Actions) ---
VERCEL_TOKEN=[COMPLETAR]
VERCEL_ORG_ID=[COMPLETAR]
VERCEL_PROJECT_ID=[COMPLETAR]
