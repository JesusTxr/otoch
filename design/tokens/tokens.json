{
  "$description": "Otoch design tokens — espejo de las variables y estilos de Figma (colección 'Otoch / Color', estilos 'Otoch/…'). Fuente de verdad para código: tokens.css.",
  "color": {
    "brand/primary": "#D9532C",
    "brand/primary-strong": "#B8401D",
    "brand/primary-soft": "#FBE3D9",
    "brand/verde": "#2F7D5B",
    "brand/verde-soft": "#DDEFE6",
    "brand/oro": "#E8A93B",
    "bg/canvas": "#FBF6F0",
    "bg/surface": "#FFFFFF",
    "bg/sunken": "#F3EBE2",
    "text/primary": "#1F1A17",
    "text/secondary": "#6E635A",
    "text/inverse": "#FFFFFF",
    "border/default": "#E8DDD1",
    "state/danger": "#C2412D"
  },
  "font": {
    "family": "Plus Jakarta Sans",
    "styles": {
      "Display web":    { "size": 56, "lineHeight": 62, "weight": 800, "letterSpacing": -1.4, "uso": "Titular de la landing web" },
      "Título web":     { "size": 32, "lineHeight": 40, "weight": 700, "letterSpacing": -0.6, "uso": "Título de página web, nombre en tarjetas grandes" },
      "Display":        { "size": 30, "lineHeight": 36, "weight": 800, "letterSpacing": -0.6, "uso": "Titular móvil, iniciales grandes" },
      "Título 1":       { "size": 24, "lineHeight": 30, "weight": 700, "letterSpacing": -0.4, "uso": "Título de pantalla móvil" },
      "Título 2":       { "size": 18, "lineHeight": 24, "weight": 700, "letterSpacing": -0.2, "uso": "Títulos de sección, precios" },
      "Cuerpo":         { "size": 15, "lineHeight": 22, "weight": 400, "letterSpacing": 0 },
      "Cuerpo fuerte":  { "size": 15, "lineHeight": 22, "weight": 600, "letterSpacing": 0 },
      "Pequeño":        { "size": 13, "lineHeight": 18, "weight": 400, "letterSpacing": 0 },
      "Pequeño fuerte": { "size": 13, "lineHeight": 18, "weight": 600, "letterSpacing": 0 },
      "Etiqueta":       { "size": 12, "lineHeight": 16, "weight": 500, "letterSpacing": 0.1 },
      "Botón":          { "size": 16, "lineHeight": 20, "weight": 700, "letterSpacing": 0 }
    }
  },
  "radius": { "pill": 999, "xl": 28, "lg": 24, "md": 20, "sm": 16, "btn": 14, "xs": 12, "isotipo": 10 },
  "shadow": {
    "card":   "0 10px 28px rgba(31,26,23,0.14)",
    "action": "0 6px 18px rgba(31,26,23,0.12)",
    "subtle": "0 4px 12px rgba(31,26,23,0.06)",
    "sticky": "0 10px 30px rgba(31,26,23,0.08)",
    "modal":  "0 24px 60px rgba(31,26,23,0.30)"
  },
  "spacing": [4, 6, 8, 10, 12, 14, 16, 20, 24, 28, 32, 40],
  "layout": {
    "mobile":  { "frame": "390x844", "paddingX": 16, "tabBarHeight": 84, "breakpoint": "<1024px" },
    "desktop": { "frame": "1440x900", "sidebarWidth": 248, "mainPaddingX": 40, "mainPaddingY": 32, "sectionGap": 24, "breakpoint": ">=1024px" }
  }
}
